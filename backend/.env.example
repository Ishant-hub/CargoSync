# CargoSync Backend Environment Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cargosync?schema=public"

# JWT Authentication Secrets
JWT_SECRET=cargosync_super_secret_jwt_key_replace_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Storage / AWS S3 Configuration
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=cargosync-documents
AWS_ACCESS_KEY_ID=your_aws_access_key_placeholder
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_placeholder
# S3_ENDPOINT=http://localhost:9000 # Optional: MinIO or LocalStack
